# HyperStore API base URL — override if pointing at a staging/local server.
HYPERSTORE_API_BASE=https://store.hypergpt.ai

# Optional: HTTP request timeout in seconds (default: 20).
HYPERSTORE_TIMEOUT=20

# Optional: User-Agent string sent to HyperStore.
HYPERSTORE_USER_AGENT=hyperstore-mcp/0.1.0

# Remote transports only — host/port for `hyperstore-mcp --http` or `--sse`.
MCP_HOST=0.0.0.0
MCP_PORT=8080

# Optional: log level (DEBUG, INFO, WARNING, ERROR).
LOG_LEVEL=INFO
