# Remote transports only — host/port for `hyperstore-mcp --transport http|sse`.
# On Railway/Heroku/Cloud Run the platform's PORT env var is picked up automatically.
MCP_HOST=0.0.0.0
MCP_PORT=8080

# Log level: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Advanced / internal — most users should not need to touch these.
# ---------------------------------------------------------------------------

# Upstream API base URL. Override only when pointing at a staging/local backend.
# HYPERSTORE_API_BASE=https://store.hypergpt.ai

# HTTP request timeout in seconds.
# HYPERSTORE_TIMEOUT=20

# User-Agent string sent to the upstream API.
# HYPERSTORE_USER_AGENT=hyperstore-mcp/0.1.1
